NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Também aceita a chave publicável mais recente:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Origem usada pela aplicação (retorno/webhook do checkout e checagem de origem no
# admin). Em produção deve ser exatamente o domínio oficial. O canonical/SEO não
# depende desta variável — ele vem de lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://almaazulacademy.com.br
PAYMENT_PROVIDER=INFINITEPAY
INFINITEPAY_HANDLE=your-infinite-tag
# Timeout por chamada ao gateway, em ms (padrão 8000, faixa 1000–20000).
# INFINITEPAY_TIMEOUT_MS=8000

# Sincronização operacional com o Google Sheets (opcional).
# Sem estas três variáveis a integração fica desligada: as reservas continuam
# confirmando normalmente e nada é enviado à planilha.
# NENHUMA delas pode usar o prefixo NEXT_PUBLIC_ — são segredos de servidor.
GOOGLE_SHEETS_SPREADSHEET_ID=your-google-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=alma-azul-sheets@your-project.iam.gserviceaccount.com
# PEM da conta de serviço com as quebras de linha escapadas como \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----\n"
# Tempo máximo por chamada ao Google, em ms (padrão 8000, faixa 1000–20000).
# GOOGLE_SHEETS_TIMEOUT_MS=8000

# E-mail transacional de confirmação de reserva (opcional).
# Sem RESEND_API_KEY e EMAIL_FROM o envio fica desligado: as reservas continuam
# confirmando normalmente e nenhum e-mail é disparado.
# NENHUMA delas pode usar o prefixo NEXT_PUBLIC_ — são segredos de servidor.
EMAIL_PROVIDER=RESEND
RESEND_API_KEY=your-resend-api-key
# Precisa ser um remetente de um domínio verificado no Resend.
EMAIL_FROM=Alma Azul Academy <reservas@almaazulacademy.com.br>
# Para onde vão as respostas do cliente. Opcional.
EMAIL_REPLY_TO=almaazulacademy@gmail.com
# Painel administrativo de Stand-by (opcional, desligado por padrão).
# Só o valor exato `true` liga o menu "Stand-by", os botões e as rotas. Exige as
# migrations 202610130001, 202610130002 e 202610140001 aplicadas no Supabase.
# Variável de servidor: NUNCA com o prefixo NEXT_PUBLIC_.
# STANDBY_ADMIN_ENABLED=true
# E-mail de confirmação do reagendamento de Stand-by (opcional, desligado por
# padrão). Só o valor exato `true` faz o cliente receber o e-mail quando a
# reserva é reagendada. Exige a migration 202610150001 aplicada e o provedor de
# e-mail acima configurado. Desligada, o reagendamento funciona igual e o e-mail
# fica na fila, sem sair. Variável de servidor: NUNCA com o prefixo NEXT_PUBLIC_.
# STANDBY_RESCHEDULE_EMAIL_ENABLED=true
# Autoatendimento do reagendamento de Stand-by (opcional, desligado por padrão).
# Só o valor exato `true` deixa o cliente escolher a nova data pelo site, com CPF
# e código ou pelo link individual. Exige a migration 202610160001 aplicada.
# Desligada, as rotas respondem 404 e a página de acompanhamento manda o cliente
# para a equipe. Variável de servidor: NUNCA com o prefixo NEXT_PUBLIC_.
# STANDBY_SELF_SERVICE_ENABLED=true
# Lista de espera — turmas esgotadas no site (fase 2, opcional, desligada por
# padrão). Só o valor exato `true` faz as turmas publicadas e esgotadas
# aparecerem na agenda e na página da experiência com o selo "Esgotado", sem
# link de reserva. Exige a migration 202610250001 aplicada (sem ela, o site
# volta sozinho para as turmas com vaga). Não cria inscrição nem envia e-mail.
# Variável de servidor: NUNCA com o prefixo NEXT_PUBLIC_.
# WAITLIST_PUBLIC_ENABLED=true
# Lista de espera — inscrição gratuita e e-mail de confirmação (fase 3,
# opcional, desligada por padrão). Só o valor exato `true`, junto com
# WAITLIST_PUBLIC_ENABLED=true, mostra "Entrar na lista de espera" nas turmas
# esgotadas, abre /lista-de-espera/<turma> e envia a confirmação por e-mail.
# Exige as migrations 202610250001 e 202610250002 aplicadas e o provedor de
# e-mail configurado. Não reserva vaga nem cobra nada. A página do link de
# cancelamento (/lista-de-espera#t=...) funciona com qualquer valor, para links
# já enviados continuarem valendo. Variável de servidor: NUNCA NEXT_PUBLIC_.
# WAITLIST_SIGNUP_ENABLED=true
# Lista de espera — painel administrativo (fase 4, opcional, desligado por
# padrão). Só o valor exato `true` mostra "Lista de espera" no menu do painel e
# abre /admin/lista-de-espera e a rota de remoção, só para ADMIN e OPERATOR.
# Exige a migration 202610250001 aplicada. Independe das variáveis do site.
# Variável de servidor: NUNCA com o prefixo NEXT_PUBLIC_.
# WAITLIST_ADMIN_ENABLED=true
# Lista de espera — envio dos avisos de vaga (fase 6, opcional, desligado por
# padrão). Só o valor exato `true` deixa /api/cron/waitlist-notifications
# enviar os avisos SPOT_AVAILABLE da fila, com o link /reservar/<turma>. Exige
# a migration 202610260002 aplicada, o provedor de e-mail e o CRON_SECRET. Sem
# a detecção (fase 5) ligada, a fila fica vazia e nada é enviado. Nenhum
# agendamento chama a rota até supabase/maintenance/waitlist_notify_schedule.sql
# ser aplicado. Variável de servidor: NUNCA com o prefixo NEXT_PUBLIC_.
# WAITLIST_NOTIFY_ENABLED=true

# Eventos especiais (fase 4): expõe /eventos, /eventos/[slug], o item "Eventos"
# no menu e o destaque da home. Ausente = desligada: as rotas respondem 404.
# Mesmo ligada, só aparece evento publicado no banco (o que exige
# special_event_settings.publication_enabled). A prévia com dados de
# demonstração (/eventos/demonstracao) não depende dela: existe só no
# desenvolvimento local e no Preview, nunca em Production.
# EVENTS_PUBLIC_ENABLED=true

# Venda de ingressos de eventos (fase 5A): com EVENTS_PUBLIC_ENABLED, abre o
# botão "Garantir minha vaga" e faz POST /api/reservations aceitar sessões de
# evento. Ausente = fechada: a API recusa reserva de evento mesmo com o id da
# sessão. NÃO ligar antes do e-mail de confirmação de evento (5B) validado.
# EVENT_BOOKING_OPEN=true

# Lista de espera dos eventos (etapa 5C): com a venda do evento aberta, o evento
# esgotado ganha o botão "Entrar na lista de espera" e /lista-de-espera/[id]
# aceita a sessão do evento. Só vale para eventos: não liga a lista das
# experiências regulares (WAITLIST_*), e elas não ligam esta. Antes de ligar,
# aplicar a migration 202610300001 (aviso de vaga só com a venda aberta e página
# de saída com textos de evento).
# EVENTS_WAITLIST_ENABLED=true

# Segredo das rotinas agendadas: /api/cron/confirmation-emails,
# /api/cron/payment-reconciliation e /api/cron/waitlist-notifications. Sem ele
# as três respondem 503 e a
# reconciliação automática de pagamento — camada 3 da confirmação — fica
# desligada. A Vercel envia o valor sozinha no cabeçalho Authorization assim que
# a variável existe no projeto.
CRON_SECRET=uma-string-longa-e-aleatoria
